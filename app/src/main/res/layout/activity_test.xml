<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:padding="32dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tv_test_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TUNNELGUARD PROTECTION TEST"
        android:textColor="@color/text_primary"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_test_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Verifying security routing parameters of your current network connection."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_test_header" />

    <!-- Test Items Container -->
    <LinearLayout
        android:id="@+id/test_items_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guideline_test"
        app:layout_constraintTop_toBottomOf="@id/tv_test_sub">

        <!-- VPN detection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VPN detection"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_test_vpn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTING..."
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Protected apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Protected apps"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_test_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTING..."
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- IPv4 protection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IPv4 protection"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_test_ipv4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTING..."
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- IPv6 protection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IPv6 protection"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_test_ipv6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTING..."
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- DNS protection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="DNS protection"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />
            <TextView
                android:id="@+id/tv_test_dns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TESTING..."
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Guideline dividing Left Side and Right Side -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.6" />

    <!-- Right Side: Verdict / Results & Action Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideline_test"
        app:layout_constraintTop_toBottomOf="@id/tv_test_sub">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESULT"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_test_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="RUNNING CHECKS..."
            android:textColor="@color/status_connecting"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_run_again"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:padding="12dp"
            android:text="Run Test Again"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_back_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:padding="12dp"
            android:text="Back to Dashboard"
            android:textColor="@color/text_primary" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>