<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/tv_item_selector"
    android:clickable="true" android:focusable="true" android:minHeight="92dp" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/timeline_item_time" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="@color/focus_highlight" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/timeline_item_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/timeline_item_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/timeline_item_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="2" android:textColor="@color/text_secondary" android:textSize="14sp" />
</LinearLayout>
