<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp"
    android:background="@drawable/tv_item_selector" android:descendantFocusability="afterDescendants"
    android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/health_item_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:id="@+id/health_item_summary" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="16sp" />
    </LinearLayout>
    <Button android:id="@+id/health_item_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/tv_button_selector" android:focusable="true" android:minHeight="56dp" android:text="Fix" android:textColor="@color/text_primary" />
</LinearLayout>
