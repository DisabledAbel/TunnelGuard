<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:padding="32dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Automatic Profile Switching" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
        <LinearLayout android:id="@+id/automation_toggle_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/tv_item_selector" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:padding="16dp" android:contentDescription="Automatic Profile Switching toggle">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Automatic Profile Switching" android:textColor="@color/text_primary" android:textSize="18sp"/>
            <CheckBox android:id="@+id/automation_toggle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="false" android:focusable="false"/>
        </LinearLayout>
        <TextView android:id="@+id/automation_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="16sp" android:padding="16dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rules (lower number has higher priority)" android:textColor="@color/focus_highlight" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <LinearLayout android:id="@+id/automation_rules" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
        <Button android:id="@+id/automation_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/tv_button_selector" android:text="Add Rule" android:textColor="@color/text_primary" android:focusable="true" android:layout_marginTop="12dp"/>
        <Button android:id="@+id/automation_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/tv_button_selector" android:text="Back" android:textColor="@color/text_primary" android:focusable="true" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
