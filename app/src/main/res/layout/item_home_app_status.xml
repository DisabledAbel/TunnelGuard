<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/tv_item_selector"
    android:layout_marginBottom="4dp">

    <ImageView
        android:id="@+id/iv_home_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_home_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="App Name" />

        <TextView
            android:id="@+id/tv_home_app_package"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:text="com.example.app" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_home_app_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/status_active"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="PROTECTED" />

</LinearLayout>
