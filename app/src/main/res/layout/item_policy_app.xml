<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="72dp" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/tv_item_selector" android:orientation="horizontal">
    <ImageView android:id="@+id/policy_app_icon" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="App icon" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/policy_app_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/policy_app_package" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
